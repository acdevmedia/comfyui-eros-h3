{
  "title": "ACDEV 10Eros H3 beta7 fix1 ComfyUI Video",
  "description": "MiniMax H3 and experimental 10Eros-Max beta7 fix1 image-to-video with synchronized audio and four/eight-step options.",
  "type": "serverless",
  "category": "video",
  "config": {
    "runsOn": "GPU",
    "endpointType": "LB",
    "containerDiskInGb": 200,
    "gpuCount": 1,
    "gpuIds": "AMPERE_80",
    "allowedCudaVersions": [
      "13.0"
    ],
    "env": [
      {
        "key": "VIDEO_VERSION",
        "value": "h3-beta7-fix1"
      },
      {
        "key": "MODEL_MODE",
        "value": "all"
      },
      {
        "key": "COMFYUI_ATTENTION",
        "value": "pytorch"
      },
      {
        "key": "HF_HOME",
        "value": "/workspace/.cache/huggingface"
      },
      {
        "key": "COPYPARTY_USERNAME",
        "value": "{{ RUNPOD_SECRET_COPYPARTY_USERNAME }}"
      },
      {
        "key": "COPYPARTY_PASSWORD",
        "value": "{{ RUNPOD_SECRET_COPYPARTY_SECRET }}"
      },
      {
        "key": "HF_TOKEN",
        "value": "{{ RUNPOD_SECRET_HUGGINGFACE_TOKEN }}"
      },
      {
        "key": "PORT",
        "value": "8000"
      },
      {
        "key": "PORT_HEALTH",
        "value": "8001"
      }
    ]
  }
}
